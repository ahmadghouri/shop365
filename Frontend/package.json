{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cp local.env .env && vite",
    "build": "cp web.env .env && vite build",
    "app-build": "cp cordova.env .env && vite build && cd cordova-app && cordova build android --release --buildConfig && cd ..",
    "app-serve-device": "cp cordova.env .env && vite build && cd cordova-app && cordova run android --device && cd ..",
    "app-serve-emulate": "cp cordova.env .env && vite build && cd cordova-app && cordova run android --emulator && cd ..",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@iconify/vue": "^4.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tinymce/tinymce-vue": "^6.1.0",
    "@tiptap/extension-table": "^2.10.4",
    "@tiptap/extension-table-cell": "^2.10.4",
    "@tiptap/extension-table-header": "^2.10.4",
    "@tiptap/extension-table-row": "^2.10.4",
    "@tiptap/starter-kit": "^2.10.4",
    "@tiptap/vue-3": "^2.10.4",
    "@vueuse/core": "^12.0.0",
    "axios": "^1.7.7",
    "canvas-confetti": "^1.9.3",
    "dayjs": "^1.11.13",
    "lodash": "^4.17.21",
    "lucide-vue-next": "^0.469.0",
    "moment-timezone": "^0.5.46",
    "pinia": "^2.2.4",
    "pinia-plugin-persistedstate": "^4.2.0",
    "quill": "^2.0.3",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "vue3-quill": "^0.3.1",
    "vue3-toastify": "^0.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "laravel-echo": "^1.16.1",
    "postcss": "^8.4.47",
    "pusher-js": "^8.4.0-rc2",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
