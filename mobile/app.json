{
  "expo": {
    "name": "Shop365",
    "slug": "shop365",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Appicon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nbthub.shop365",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.nbthub.shop365",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#1F2B3D"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Shop365 to use your location for accurate delivery."
        }
      ],
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F2B705"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Shop365 to access your photos to set your profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2e520031-0fd8-46a2-893c-086a739857aa"
      }
    }
  }
}