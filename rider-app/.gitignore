# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Expo ────────────────────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# ─── EAS / Native builds ─────────────────────────────────────────────────────
/ios
/android
.kotlin/

# ─── Secrets & Certificates ──────────────────────────────────────────────────
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ─── Environment files ───────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging

# ─── Metro bundler ───────────────────────────────────────────────────────────
.metro-health-check*

# ─── Debug logs ──────────────────────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# ─── OS generated ────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Editor / IDE ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Testing & Coverage ──────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Misc ────────────────────────────────────────────────────────────────────
*.pem
.cache/
tmp/
temp/
